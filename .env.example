# Copy this file to .env before building, running or testing the app (.env is not committed).
# The app bundles .env as an asset, so `flutter test` fails on a fresh clone without it.

# Android emulator reaching the local backend. Use the machine's LAN IP on a real phone,
# and the production HTTPS URL for release builds.
BASE_URL=http://10.0.2.2:8000/api
HOST_URL=http://10.0.2.2:8000
